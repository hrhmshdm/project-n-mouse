#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    /* 5つのボタン設定 (D0〜D4) */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* SW1: 左クリック */
            , <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* SW2: 右クリック */
            , <&xiao_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* SW3: 中クリック */
            , <&xiao_d 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* SW4: サイドボタン */
            , <&xiao_d 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> /* SW5: モードボタン */
            ;
    };

    /* ★修正：stepsとtriggersを両方24に揃え、1ノッチ目から100%反応させる */
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <24>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <24>; /* ★12から24に変更（2〜3パルス空振りする原因を解消） */
    };

    paw3395_listener {
        compatible = "zmk,input-listener";
        device = <&pd0>;

        /* ★レイヤー1（サイドボタン長押し中）：遅い・精密な無段階スクロール (1/16倍) */
        drag_scroll_slow {
            layers = <1>;
            input-processors = <&zip_xy_scaler 1 16>, <&zip_xy_to_scroll_mapper>;
        };

        /* ★レイヤー2（サイド＋右クリック中）：超高速の無段階スクロール (1/3倍) */
        drag_scroll_fast {
            layers = <2>;
            input-processors = <&zip_xy_scaler 1 3>, <&zip_xy_to_scroll_mapper>;
        };
    };
};

&i2c0 {
    status = "disabled";
};

&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    cs-gpios = <&xiao_d 7 GPIO_ACTIVE_LOW>;

    pd0: pd@0 {
        compatible = "pixart,paw3395";
        status = "okay";
        label = "MOU0";
        reg = <0>;
        spi-max-frequency = <4000000>;
        irq-gpios = <&gpio0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <1000>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        invert-x;
    };
};
