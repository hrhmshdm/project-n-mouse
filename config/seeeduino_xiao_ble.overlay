#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <zmk-input-inertia/input/processors.dtsi> // ★追加：慣性モジュールの読み込み

/* ★追加：慣性（イナーシャ）の挙動設定 */
&zip_inertia {
    trigger-ms = <40>;                  // 入力停止から慣性が始まるまでの待機時間(ms)
    scroll-decay-factor-int = <88>;     // 慣性の残りやすさ（0〜99%：85〜92が大きいほど長く回る）
    scroll-report-interval-ms = <25>;   // 慣性スクロールの更新間隔（小さいほど滑らか）
    scroll-threshold-start = <2>;       // 慣性が発動する最小の勢い（ゆっくり回した時は発動しない）
    scroll-threshold-stop = <0>;        // 停止判定のしきい値
    cancel-scroll-inertia-on-ctrl;      // Ctrlキー押下時は勝手に拡大縮小されないよう慣性を即停止
};

/* ★追加：物理ホイール（&msc）の出力を3倍に増幅し、慣性をかける */
&msc_input_listener {
    input-processors = <&zip_scroll_scaler 3 1>, <&zip_inertia>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&xiao_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&xiao_d 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&xiao_d 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <24>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <12>;
    };

    paw3395_listener {
        compatible = "zmk,input-listener";
        device = <&pd0>;

        /* レイヤー2（サイド＋右クリック）：マウス移動での無段階スクロールにも慣性を適用 */
        drag_scroll {
            layers = <2>;
            input-processors = <&zip_xy_scaler 1 6>, <&zip_xy_to_scroll_mapper>, <&zip_inertia>;
        };
    };
};

&i2c0 {
    status = "disabled";
};

&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    cs-gpios = <&xiao_d 7 GPIO_ACTIVE_LOW>;

    pd0: pd@0 {
        compatible = "pixart,paw3395";
        status = "okay";
        label = "MOU0";
        reg = <0>;
        spi-max-frequency = <4000000>;
        irq-gpios = <&gpio0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <1000>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        invert-x;
    };
};
