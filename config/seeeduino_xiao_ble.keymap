#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// ★tap-ms=10msでもしっかり初速が出て、かつ高速回転で伸びる設定
&msc {
    time-to-max-speed-ms = <150>;
    acceleration-exponent = <1>;  // 10msの短パルスでも減衰しすぎないよう「1」に設定
    delay-ms = <0>;
};

/ {
    macros {
        bt_nxt_m: bt_nxt_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_NXT>;
        };

        bt_clr_m: bt_clr_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    behaviors {
        // SW4用：単押しで「戻る(MB4)」、長押し中はレイヤー1（拡張ボタン＆ホイール横スクロール）
        lt_mkp: layer_tap_mouse_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            bindings = <&mo>, <&mkp>;
        };

        // SW5用：短押しで次の接続先へ、2秒長押しでペアリング解除
        bt_mode: bt_mode_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <2000>;
            bindings = <&bt_clr_m>, <&bt_nxt_m>;
        };

        // ★縦スクロール：tap-msを「10ms」に極小化し、信号が重なって下に入りっぱなしになるバグを防止
        scroll_v: sensor_scroll_v {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(600)>, <&msc MOVE_Y(-600)>;
            tap-ms = <10>;
        };

        // 横スクロール
        scroll_h: sensor_scroll_h {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_X(-600)>, <&msc MOVE_X(600)>;
            tap-ms = <10>;
        };

    keymap {
        compatible = "zmk,keymap";

        // レイヤー0：通常モード
        default_layer {
            bindings = <
                &mkp LCLK       // 左クリック
                &mkp RCLK       // 右クリック
                &mkp MCLK       // 中クリック
                &lt_mkp 1 MB4   // サイド：単押し「戻る」、長押しでレイヤー1へ
                &bt_mode 0 0    // モード：短押し「プロファイル順送り」、2秒長押し「ペアリング解除」
            >;
            sensor-bindings = <&scroll_v>;
        };

        // レイヤー1：サイドボタン長押し中（カーソル移動は通常通り）
        scroll_layer {
            bindings = <
                &mkp MB5         // サイド＋左クリック：進む(MB5)
                &mo 2            // サイド＋右クリック長押し：超高速自由スクロール(レイヤー2)へ
                &kp LG(TAB)      // サイド＋中クリック：Win + Tab
                &trans           // サイド自身
                &bt BT_SEL 0     // サイド＋モードボタン：プロファイル0番へ一発切替
            >;
            // サイドを押しながらホイールを回すと横スクロール（逆方向適用済み）
            sensor-bindings = <&scroll_h>;
        };

        // レイヤー2：サイド＋右クリック長押し中（マウスを動かすと超高速・自由スクロール）
        fast_scroll_layer {
            bindings = <
                &bt BT_SEL 0     // サイド＋右＋左クリック：プロファイル0（Win）へ切替
                &trans
                &bt BT_SEL 1     // サイド＋右＋中クリック：プロファイル1（Mac）へ切替
                &trans
                &trans
            >;
            sensor-bindings = <&scroll_v>;
        };
    };
};
