#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// ★ホイールの緩急設定：1ノッチ単発は控えめ、連続で素早く回すと2乗カーブで爆発的に加速
&msc {
    time-to-max-speed-ms = <300>; // 連続回転し続けると300msかけて最高速へ急加速
    acceleration-exponent = <2>;  // 2乗カーブ（ゆっくり＝細かい動き、素早く回す＝超高速）
    delay-ms = <0>;
};

/ {
    macros {
        bt_nxt_m: bt_nxt_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_NXT>;
        };

        bt_clr_m: bt_clr_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    behaviors {
        // SW4用：単押しで「戻る(MB4)」、長押し中はレイヤー1（精密スクロール＆拡張ボタン）
        lt_mkp: layer_tap_mouse_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            bindings = <&mo>, <&mkp>;
        };

        // SW5用：短押しで次の接続先へ、2秒長押しでペアリング解除
        bt_mode: bt_mode_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <2000>;
            bindings = <&bt_clr_m>, <&bt_nxt_m>;
        };

        // ★縦スクロール：tap-ms=50msにし、ゆっくり回せば1ノッチ1スクロール、素早く回せば信号が繋がって急加速
        scroll_v: sensor_scroll_v {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(500)>, <&msc MOVE_Y(-500)>;
            tap-ms = <50>;
        };

        // 横スクロール
        scroll_h: sensor_scroll_h {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_X(500)>, <&msc MOVE_X(-500)>;
            tap-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // レイヤー0：通常モード
        default_layer {
            bindings = <
                &mkp LCLK       // 左クリック
                &mkp RCLK       // 右クリック
                &mkp MCLK       // 中クリック
                &lt_mkp 1 MB4   // サイド：単押し「戻る」、長押し中「遅い無段階スクロール(レイヤー1)」
                &bt_mode 0 0    // モード：短押し「プロファイル順送り」、2秒長押し「ペアリング解除」
            >;
            sensor-bindings = <&scroll_v>;
        };

        // レイヤー1：サイドボタン長押し中（マウスを動かすと「遅い・精密スクロール」）
        scroll_layer {
            bindings = <
                &mkp MB5         // サイド＋左クリック：進む(MB5)
                &mo 2            // サイド＋右クリック長押し：超高速無段階スクロール(レイヤー2)へシフト
                &kp LG(TAB)      // サイド＋中クリック：Win + Tab
                &trans           // サイド自身
                &bt BT_SEL 0     // サイド＋モードボタン：プロファイル0番（Windows用）へ一発切替
            >;
            // サイドを押しながらホイールを回すと横スクロール
            sensor-bindings = <&scroll_h>;
        };

        // レイヤー2：サイド＋右クリック長押し中（マウスを動かすと「超高速・無段階スクロール」）
        fast_scroll_layer {
            bindings = <
                &bt BT_SEL 0     // （裏機能）サイド＋右＋左クリック：プロファイル0（Win）へ切替
                &trans
                &bt BT_SEL 1     // （裏機能）サイド＋右＋中クリック：プロファイル1（Mac）へ切替
                &trans
                &trans
            >;
            sensor-bindings = <&scroll_v>;
        };
    };
};
