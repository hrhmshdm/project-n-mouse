#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // 複数ボタンの同時押し（コピー・ペースト）を判定するコンボ定義
    combos {
        compatible = "zmk,combos";

        // レイヤー0：左クリック ＋ 右クリック ＝ コピー (Ctrl + C)
        combo_copy {
            timeout-ms = <50>;
            key-positions = <0 1>; // 0: LCLK, 1: RCLK
            bindings = <&kp LC(C)>;
            layers = <0>;
        };

        // レイヤー1：サイドボタン長押し中 ＋ 左クリック ＋ 右クリック ＝ ペースト (Ctrl + V)
        combo_paste {
            timeout-ms = <50>;
            key-positions = <0 1>; // 0: LCLK, 1: RCLK
            bindings = <&kp LC(V)>;
            layers = <1>;
        };
    };

    macros {
        bt_nxt_m: bt_nxt_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_NXT>;
        };

        bt_clr_m: bt_clr_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    behaviors {
        // SW4用：単押しで「戻る(MB4)」、長押し中はレイヤー1へ
        lt_mkp: layer_tap_mouse_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            bindings = <&mo>, <&mkp>;
        };

        // 右クリック（RCLK）を長押しするとレイヤー2に切り替わるホールドタップ（レイヤー1内）
        lt_rclk_layer2: layer_tap_rclk_layer2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            bindings = <&mo>, <&mkp>;
        };

        // SW5用：短押しで次の接続先へ、2秒長押しでペアリング解除
        bt_mode: bt_mode_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <2000>;
            bindings = <&bt_clr_m>, <&bt_nxt_m>;
        };

        // v0.3移植版の1ノッチ＝1ダイレクト送信スクロール
        ec_ms: encoder_mouse_scroll {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // レイヤー0：通常モード（縦スクロール ＆ 左＋右クリックでコピー）
        default_layer {
            bindings = <
                &mkp LCLK       // 0: 左クリック
                &mkp RCLK       // 1: 右クリック
                &mkp MCLK       // 2: 中クリック
                &lt_mkp 1 MB4   // 3: サイド（単押し:戻る / 長押し:レイヤー1へ）
                &bt_mode 0 0    // 4: モード（短押し:次へ / 長押し:ペアリング解除）
            >;
            sensor-bindings = <&ec_ms SCRL_UP SCRL_DOWN>;
        };

        // レイヤー1：サイドボタン長押し中（横スクロール ＆ 右クリック長押しでレイヤー2へ）
        scroll_layer {
            bindings = <
                &mkp MB5                 // サイド＋左クリック：進む(MB5)
                &lt_rclk_layer2 2 RCLK   // 右クリック（単押し:右クリック / 長押し:レイヤー2へ）
                &kp LG(TAB)              // サイド＋中クリック：Win + Tab
                &trans                   // サイド自身
                &bootloader              // SW5: ファームウェア書込モード
            >;
            sensor-bindings = <&ec_ms SCRL_LEFT SCRL_RIGHT>;
        };

        // レイヤー2：サイド ＋ 右クリック長押し中（自由＆高速スクロール）
        fast_scroll_layer {
            bindings = <
                &bt BT_SEL 0     // サイド ＋ 右長押し ＋ 左クリック ＝ プロファイル 0
                &bt BT_SEL 1     // サイド ＋ 右長押し ＋ 中クリック ＝ プロファイル 1
                &trans
                &trans
                &trans
            >;
            sensor-bindings = <&ec_ms SCRL_UP SCRL_DOWN>;
        };
    };
};
