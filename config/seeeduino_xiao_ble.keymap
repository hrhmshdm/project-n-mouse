#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // ==========================================================
    // Combos (Simultaneous Key Press) / 同時押しコンボ設定
    // ==========================================================
    combos {
        compatible = "zmk,combos";

        // Layer 0: Left Click + Right Click = Copy (Ctrl + C)
        // レイヤー0：左クリック ＋ 右クリック ＝ コピー (Ctrl + C)
        combo_copy {
            timeout-ms = <50>;
            key-positions = <0 1>; // 0: LCLK, 1: RCLK
            bindings = <&kp LC(C)>;
            layers = <0>;
        };

        // Layer 1: Left Click + Right Click (while holding Side) = Paste (Ctrl + V)
        // レイヤー1：サイド長押し中 ＋ 左クリック ＋ 右クリック ＝ ペースト (Ctrl + V)
        combo_paste {
            timeout-ms = <50>;
            key-positions = <0 1>; // 0: LCLK, 1: RCLK
            bindings = <&kp LC(V)>;
            layers = <1>;
        };
    };

    // ==========================================================
    // Macros / マクロ定義
    // ==========================================================
    macros {
        // Next Bluetooth profile macro
        // 次のBluetoothプロファイルへ切り替え
        bt_nxt_m: bt_nxt_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_NXT>;
        };

        // Clear current Bluetooth profile macro
        // 現在のBluetoothプロファイルのペアリング解除
        bt_clr_m: bt_clr_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    // ==========================================================
    // Custom Behaviors / カスタム動作定義
    // ==========================================================
    behaviors {
        // SW4 (Side): Tap for MB4 (Back), Hold for Layer 1
        // SW4（サイド）：単押しで「戻る(MB4)」、長押し中はレイヤー1へ移行
        lt_mkp: layer_tap_mouse_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            bindings = <&mo>, <&mkp>;
        };

        // In Layer 1: Tap for RCLK, Hold for Layer 2 (Fast scroll & BT select)
        // レイヤー1内：右クリック単押しで「RCLK」、長押しでレイヤー2へ移行
        lt_rclk_layer2: layer_tap_rclk_layer2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            bindings = <&mo>, <&mkp>;
        };

        // SW5 (Mode): Tap for Next BT Profile, Hold (2 sec) to Clear Profile
        // SW5（モード）：短押しで次の接続先へ、2秒長押しでペアリング解除
        bt_mode: bt_mode_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <2000>;
            bindings = <&bt_clr_m>, <&bt_nxt_m>;
        };

        // Direct 1-pulse to 1-report integer wheel scroll behavior (ported for ZMK v0.3)
        // 1ノッチ＝1ダイレクト送信の低遅延スクロール動作（v0.3移植版）
        /*
         * =====================================================================
         * [Custom Behavior] 1:1 Direct Integer Wheel Scroll (ec_ms)
         * ---------------------------------------------------------------------
         * [What it is / 概要]:
         *   Custom encoder behavior ported from elekit's (elek1t) scroll logic
         *   to maintain compatibility with ZMK v0.3.
         *   ZMK標準の慣性スクロール（小数レポート・加速）を通さず、ハードウェアの
         *   1クリック（1ノッチ）に対して HID レポート「±1」を即時・ダイレクトに
         *   送信する低遅延スクロール動作。
         *
         * [Why it's needed / 理由]:
         *   ZMK標準のマウススクロールではホイールの1目盛り回転に対して入力が遅れたり、
         *   中途半端なスクロール量で空振りする現象を防ぐため。
         * =====================================================================
         */
        ec_ms: encoder_mouse_scroll {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };

    // ==========================================================
    // Keymap Layers / キーマップ定義
    // ==========================================================
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Default / 通常モード
        // - Vertical scroll
        // - LCLK + RCLK: Copy (Ctrl + C)
        // - Mode tap: Next BT / Mode hold (2s): Clear BT
        default_layer {
            bindings = <
                &mkp LCLK       // 0: Left Click / 左クリック
                &mkp RCLK       // 1: Right Click / 右クリック
                &mkp MCLK       // 2: Middle Click / 中クリック
                &lt_mkp 1 MB4   // 3: Side Switch (Tap: Back MB4 / Hold: Layer 1)
                &bt_mode 0 0    // 4: Mode Switch (Tap: Next BT / Hold 2s: Clear BT)
            >;
            sensor-bindings = <&ec_ms SCRL_UP SCRL_DOWN>;
        };

        // Layer 1: Navigation Layer / ナビゲーションレイヤー（サイドボタン長押し中）
        // - Horizontal scroll
        // - LCLK + RCLK: Paste (Ctrl + V)
        // - Hold RCLK: Transition to Layer 2
        // - Mode button: Enter bootloader
        scroll_layer {
            bindings = <
                &mkp MB5                 // 0: Side + LCLK: Forward (MB5) / 進む
                &lt_rclk_layer2 2 RCLK   // 1: Side + RCLK (Tap: RCLK / Hold: Layer 2)
                &kp LG(TAB)              // 2: Side + MCLK: Task View (Win + Tab)
                &trans                   // 3: Side Button (Transparent)
                &bootloader              // 4: Mode Button: DFU Bootloader Mode / 書込モード
            >;
            sensor-bindings = <&ec_ms SCRL_LEFT SCRL_RIGHT>;
        };

        // Layer 2: System & Profile Layer / システム・BT切替レイヤー（サイド ＋ 右クリック長押し中）
        // - Fast navigation & direct BT profile switching
        fast_scroll_layer {
            bindings = <
                &bt BT_SEL 0     // 0: Side + RCLK + LCLK: Select Profile 0 (Win)
                &trans           // 1: Transparent
                &bt BT_SEL 1     // 2: Side + RCLK + MCLK: Select Profile 1 (Mac)
                &trans           // 3: Transparent
                &trans           // 4: Transparent
            >;
            sensor-bindings = <&ec_ms SCRL_UP SCRL_DOWN>;
        };
    };
};
