#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Bluetoothコマンドを直接呼び出すとエラーになるため、マクロで包む
    macros {
        bt_nxt_m: bt_nxt_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_NXT>;
        };

        bt_clr_m: bt_clr_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };

        msc_up_m: msc_up_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&msc SCRL_UP>;
        };

    msc_dn_m: msc_dn_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>;
        };
    };

    behaviors {
        // マウスボタンとレイヤー切り替えの併用（SW4用）
        lt_mkp: layer_tap_mouse_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };

        // BLEプロファイル切り替え用：短押しで次へ(NXT)、長押しで削除(CLR)
        bt_mode: bt_mode_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred"; /* 長押しを優先して確実に判定 */
            tapping-term-ms = <2000>;  /* 2.0秒長押しでペアリング解除 */
            bindings = <&bt_clr_m>, <&bt_nxt_m>;
        };

        // 縦スクロール用の固定動作（tap-msは外す）
        scroll_v: sensor_scroll_v {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc_dn_m>, <&msc_up_m>;
            tap-ms = <50>;  // ←これを必ず入れます
        };
    
        // 横スクロール用の固定動作
        scroll_h: sensor_scroll_h {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
            tap-ms = <50>;  // ←これを必ず入れます
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mkp LCLK
                &mkp RCLK
                &mkp MCLK
                &lt_mkp 1 MB4
                &bt_mode 0 0    // 短押し: プロファイル切替, 長押し(2.0秒): ペアリング解除
            >;
            // 縦スクロールを割り当て
            sensor-bindings = <&scroll_v>;
        };

        scroll_layer {
            bindings = <
                &trans
                &trans
                &trans
                &trans
                &trans
            >;
            // 横スクロールを割り当て
            sensor-bindings = <&scroll_h>;
        };
    };
};
