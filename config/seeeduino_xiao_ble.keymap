#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        bt_nxt_m: bt_nxt_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_NXT>;
        };

        bt_clr_m: bt_clr_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    behaviors {
        // SW4用：単押しで「戻る(MB4)」、長押し中はレイヤー1（拡張ボタン＆ホイール横スクロール）
        lt_mkp: layer_tap_mouse_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            bindings = <&mo>, <&mkp>;
        };

        // SW5用：短押しで次の接続先へ、2秒長押しでペアリング解除
        bt_mode: bt_mode_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <2000>;
            bindings = <&bt_clr_m>, <&bt_nxt_m>;
        };

        // ★zmk_encoder（v0.3移植版）：1ノッチごとに整数「1」をダイレクト送信
        ec_ms: encoder_mouse_scroll {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // レイヤー0：通常モード（ホイール：縦スクロール）
        default_layer {
            bindings = <
                &mkp LCLK       // 左クリック
                &mkp RCLK       // 右クリック
                &mkp MCLK       // 中クリック
                &lt_mkp 1 MB4   // サイド：単押し「戻る」、長押しでレイヤー1へ
                &bt_mode 0 0    // モード：短押し「プロファイル順送り」、2秒長押し「ペアリング解除」
            >;
            // ※上下の回転方向が逆の場合は SCRL_UP と SCRL_DOWN を入れ替えてください
            sensor-bindings = <&ec_ms SCRL_UP SCRL_DOWN>;
        };

        // レイヤー1：サイドボタン長押し中（ホイール：横スクロール）
        scroll_layer {
            bindings = <
                &mkp MB5         // サイド＋左クリック：進む(MB5)
                &mo 2            // サイド＋右クリック長押し：超高速自由スクロール(レイヤー2)へ
                &kp LG(TAB)      // サイド＋中クリック：Win + Tab
                &trans           // サイド自身
                &bootloader      // SW5: サイド＋モードボタンでファームウェア書込モードへ
            >;
            sensor-bindings = <&ec_ms SCRL_LEFT SCRL_RIGHT>;
        };

        // レイヤー2：サイド＋右クリック長押し中（マウスを動かすと超高速・自由スクロール）
        fast_scroll_layer {
            bindings = <
                &bt BT_SEL 0     // サイド＋右＋左クリック：プロファイル0（Win）へ切替
                &trans
                &bt BT_SEL 1     // サイド＋右＋中クリック：プロファイル1（Mac）へ切替
                &trans
                &trans
            >;
            sensor-bindings = <&ec_ms SCRL_UP SCRL_DOWN>;
        };
    };
};
