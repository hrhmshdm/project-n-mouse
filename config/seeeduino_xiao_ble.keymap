#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Bluetoothコマンドを直接呼び出すとエラーになるため、マクロで包む
    macros {
        bt_nxt_m: bt_nxt_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_NXT>;
        };

        bt_clr_m: bt_clr_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };
    };

    behaviors {
        // マウスボタンとレイヤー切り替えの併用（SW4用）
        lt_mkp: layer_tap_mouse_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&mkp>;
        };

        // BLEプロファイル切り替え用：短押しで次へ(NXT)、長押しで削除(CLR)
        bt_mode: bt_mode_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred"; /* 長押しを優先して確実に判定 */
            tapping-term-ms = <2000>;  /* 2.0秒長押しでペアリング解除 */
            bindings = <&bt_clr_m>, <&bt_nxt_m>;
        };

        rot_msc_v: sensor_rotate_msc_v {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };

        rot_msc_h: sensor_rotate_msc_h {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mkp LCLK
                &mkp RCLK
                &mkp MCLK
                &lt_mkp 1 MB4
                &bt_mode 0 0    // 短押し: プロファイル切替, 長押し(2.0秒): ペアリング解除
            >;
            sensor-bindings = <&inc_dec_kp UP DOWN>;
        };

        scroll_layer {
            bindings = <
                &trans
                &trans
                &trans
                &trans
                &trans
            >;
            sensor-bindings = <&rot_msc_h SCRL_RIGHT SCRL_LEFT>;
        };
    };
};
